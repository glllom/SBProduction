; ---------------------------------------------------------------------------
;NOME : STD_KeyHole
;DESCRIZIONE : KeyHole operation 
;TIPO : 1
;DIMENSIONI : 10 10 10
; ---------------------------------------------------------------------------
; v1.0 - 03-08-2016 - DC@Mecal
; ---------------------------------------------------------------------------
; Creates a KeyHole with specified diameters and length
; Origin of the work is referred on the centre of the big hole
; Can be rotated along his centre
; ---------------------------------------------------------------------------
PARAM L1 = 0     "Starting z-point"
PARAM L2 = 10    "Big Diameter"
PARAM L3 = 5     "Small Diameter"
PARAM L4 = 20    "Length"
PARAM L5 = 0     "Rotation angle along Z-axis"
PARAM L6 = 0     "Free"
PARAM L7 = 0     "Free"
PARAM L8 = 0     "Free"
PARAM L9 = 0     "Space2"
PARAM L10 = 0    "Depth2"
PARAM L11 = 0    "Space3"
PARAM L12 = 0    "Depth3"
PARAM L13 = 0    "Space4"
PARAM L14 = 0    "Depth4"
PARAM L15 = 0    "Space5"
PARAM L16 = 0    "Depth5"
PARAM L17 = 0    "Space6"
PARAM L18 = 0    "Depth6"
PARAM L19 = 0    "Space7"
PARAM L20 = 0    "Depth7"
PARAM L21 = 0    "Space8"
PARAM L22 = 0    "Depth8"
PARAM L23 = 0    "Space9"
PARAM L24 = 0    "Depth9"
; ---------------------------------------------------------------------------

L72 = L92
L73 = L1

G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

G79 (L10 = 0) N1000
L72 = L10
L73 = L73 + L92 + L9
G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

G79 (L12 = 0) N1000
L72 = L12
L73 = L73 + L10 + L11
G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

G79 (L14 = 0) N1000
L72 = L14
L73 = L73 + L12 + L13
G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

G79 (L16 = 0) N1000
L72 = L16
L73 = L73 + L14 + L15
G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

G79 (L18 = 0) N1000
L72 = L18
L73 = L73 + L16 + L17
G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

G79 (L20 = 0) N1000
L72 = L20
L73 = L73 + L18 + L19
G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

G79 (L22 = 0) N1000
L72 = L22
L73 = L73 + L20 + L21
G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

G79 (L24 = 0) N1000
L72 = L24
L73 = L73 + L22 + L23
G120 X(L90) Y(L91) Z(L72) L(L73) T(L86) O99 U0 D(L2) H(L3) S(L4) A(L5)

N1000
