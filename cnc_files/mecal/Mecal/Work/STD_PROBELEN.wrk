;#WRKINFO{Version="1.0.0", Date="09/05/2019"}
;NOME : STD_PROBELEN
;DESCRIZIONE : Feels the profile length and associates a probe index
;TIPO : 0
;DIMENSIONI : 100.00 100.00 0.00

PARAM L1=0 	"Probing index"
PARAM L2=0 	"0 Real probing, 1 use previous data"

G314 X(L80+L90) Y(L91) Z(L92) M(L88) R(L2) K(L1) O(99)

;#TRANSL{Param="NOME", Lang="ENG", Value="Piece length Measure"}
;#TRANSL{Param="NOME", Lang="ITA", Value="Misurazione lunghezza Pezzo")
;#TRANSL{Param="DESCRIZIONE", Lang="ITA", Value="Misura la lunghezza del profilo")
;#TRANSL{Param="L1", Lang="ITA", Value="Indice tastatura associato"}
;#TRANSL{Param="L2", Lang="ITA", Value="0 misura reale, 1 usa ultima tastatura"}
