; ---------------------------------------------------------------------------
;NOME : STD_DEFREDZONE
;DESCRIZIONE : Creates a custom red zone
;TIPO : 0
;DIMENSIONI : 100.00 100.00 0.00
; ---------------------------------------------------------------------------
; v1.0 - 2017-04-26
; ---------------------------------------------------------------------------
; Adds a user-defined red zone on the piece. Red zone starts from 
; the X position defined in the macro call and its length is defined by 
; parameter L1.
; ---------------------------------------------------------------------------
PARAM L1 = 0      "Red Zone length"
; ---------------------------------------------------------------------------

L72 = L90
L73 = L1

G1030 X(L72) D(L73)
