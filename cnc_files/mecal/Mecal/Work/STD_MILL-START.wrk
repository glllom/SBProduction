PARAM L1 = 0    "Compensation 0=Center -1=Left 1=Right"
; ---------------------------------------------------------------------------

G150 O99 Z(L92) T(L86)

G79 (L1>0) N100
G79 (L1<0) N200
G79 (L1=0) N300

G40

N100
G42
G79 N300

N200
G41
G79 N300

N300
G151 X(L90) Y(L91) Z(L92)
