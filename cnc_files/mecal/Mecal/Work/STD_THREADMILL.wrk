; ---------------------------------------------------------------------------
;NOME : STD_THREADMILL
;DESCRIZIONE : Thread millig operation (Single Depth)
;TIPO : 1
;DIMENSIONI : 10 10 10
; ---------------------------------------------------------------------------
; v1.0 - 30-08-2017 - MP@Mecal
; ---------------------------------------------------------------------------
; Creates a thread milling
; Origin of the work is referred on the centre of the tapping
; ---------------------------------------------------------------------------
PARAM L1 = 0      "Starting Z-Point"
PARAM L2 = 6.3mm  "Thread ext diameter"
PARAM L3 = 1      "Thread Z-Pitch"
PARAM L4 = 0      "0=CW (regular) / 1=CCW (inverted)"
PARAM L5 = 0      "Free"
PARAM L6 = 1      "Number of workings"
PARAM L7 = 25mm   "X-Pitch"
PARAM L8 = 0      "Free"
PARAM L9 = 0      "Free"
PARAM L10 = 0     "Free"
PARAM L11 = 0     "Free"
PARAM L12 = 0     "Free"
PARAM L13 = 0     "Free"
PARAM L14 = 0     "Free"
PARAM L15 = 0     "Free"
PARAM L16 = 0     "Free"
PARAM L17 = 0     "Free"
PARAM L18 = 0     "Free"
PARAM L19 = 0     "Free"
PARAM L20 = 0     "Free"
PARAM L21 = 0     "Free"
PARAM L22 = 0     "Free"
PARAM L23 = 0     "Free"
PARAM L24 = 0     "Free"
; ---------------------------------------------------------------------------

L50 = 0
L51 = L90
L52 = (L2 - GETTOOL(L86, 2)) / 2
L53 = L91

; Skip se diametro troppo piccolo
G79 (L52 < 0.5) N99

; Preset coordinate
L54 = (L52)
L56 = 3		; G3

; Inversione coordinate X in caso di filetto antiorario
G79 (L4 = 0) N10
L54 = (-L52)
L56 = 2		; G2

N10
G150 Z(L92) O99 L(L1) T(L86)
G151 X(L51) Y(L53) Z(0) 

; Entry
L64=0
G(L56) X(L51) Y(L53+L52) Z(L64) R(L52/2)

; Z - Thread loop
N50 
G(L56) X(L51-L54) Y(L53) Z(L64+1*L3/4) R(L52)
G(L56) X(L51) Y(L53-L52) Z(L64+2*L3/4) R(L52)
G(L56) X(L51+L54) Y(L53) Z(L64+3*L3/4) R(L52)
G(L56) X(L51) Y(L53+L52) Z(L64+4*L3/4) R(L52)
L64=L64+L3
G79 (L64 < L92) N50

; Exit
G(L56) X(L51) Y(L53) Z(L64+4*L3/4) R(L52/2) 
G152

L50 = L50 + 1
L51 = L51 + L7
G79 (L50 < L6) N10

N99
